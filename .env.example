# Bitbucket Cloud credentials (required for publish)
# Create App Password: Bitbucket → Personal settings → App passwords
# Scopes: Pull requests — Read + Write
BITBUCKET_USERNAME=your-bitbucket-username
BITBUCKET_APP_PASSWORD=your-app-password

# Optional: Bearer token instead of App Password (leave username empty if using this)
# BITBUCKET_TOKEN=

# Defaults (override per publish CLI flags)
BITBUCKET_WORKSPACE=project-jakarta
BITBUCKET_REPO_SLUG=dealer-platform
