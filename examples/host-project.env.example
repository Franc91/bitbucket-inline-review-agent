# Copy these into the **host product project** env (e.g. env/.env.development).
# Do NOT put secrets in the bitbucket-inline-review-agent kit repo.

# Atlassian account email (API tokens use email, not Bitbucket username)
BITBUCKET_USERNAME=

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Scopes: read:pullrequest:bitbucket, write:pullrequest:bitbucket
BITBUCKET_API_TOKEN=

# Optional overrides (kit config/defaults.json used if unset)
BITBUCKET_WORKSPACE=project-jakarta
BITBUCKET_REPO_SLUG=dealer-platform

# Optional: OAuth Bearer access token instead of email+API token
# BITBUCKET_TOKEN=
